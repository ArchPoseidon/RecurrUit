# Neon Postgres connection string
DATABASE_URL=

# Gemini API key
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Single-user app password gate
APP_PASSWORD=
# Random secret used to sign the session cookie (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Resend API key + sending identity are configured in-app via Settings,
# not via env vars — nothing needed here for email sending.

# Demo mode only: overrides every uploaded CV's outreach email to this fixed
# address, so test sends never reach a real candidate. Leave unset in a real
# production deployment.
DEMO_OUTREACH_EMAIL=
